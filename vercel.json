{
  "functions": {
    "*.php": {
      "runtime": "vercel-php@0.6.0"
    },
    "pages/*.php": {
      "runtime": "vercel-php@0.6.0"
    },
    "php/*.php": {
      "runtime": "vercel-php@0.6.0"
    }
  },
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/images/(.*)",
      "dest": "/images/$1"
    },
    {
      "src": "/pages/(.*\\.php)",
      "dest": "/pages/$1"
    },
    {
      "src": "/php/(.*\\.php)",
      "dest": "/php/$1"
    },
    {
      "src": "/(.*\\.php)",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.php"
    }
  ]
}
